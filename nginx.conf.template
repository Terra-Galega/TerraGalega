server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Los .mjs (worker de MapLibre) deben servirse como JavaScript
    types {
        include /etc/nginx/mime.types;
        application/javascript mjs;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Archivos con hash en el nombre: caché larga
    location ~* \.(?:js|css|woff2?|png|jpe?g|svg|webp|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: cualquier ruta de Angular (p. ej. /checkout/result) devuelve index.html
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
